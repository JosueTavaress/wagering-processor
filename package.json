{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.23",
  "scripts": {
    "start": "bun src/main.ts",
    "worker": "bun src/worker.ts",
    "migrate": "bun scripts/migrate.ts",
    "queues": "bun scripts/queues.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit",
    "test:integration": "bun scripts/preflight.ts && bun test --timeout 120000 test/integration",
    "test:concurrency": "bun scripts/preflight.ts && bun test --timeout 180000 test/concurrency",
    "test:all": "bun run typecheck && bun run test && bun run test:integration && bun run test:concurrency",
    "demo": "bun scripts/demo.ts",
    "format": "prettier --write src scripts test *.md *.json compose.yaml .github/workflows/ci.yml",
    "format:check": "prettier --check src scripts test *.md *.json compose.yaml .github/workflows/ci.yml"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@mikro-orm/core": "6.4.7",
    "@mikro-orm/postgresql": "6.4.7",
    "@aws-sdk/client-sqs": "3.758.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.24.2",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/bun": "1.2.23",
    "@types/node": "22.13.10",
    "@types/express": "5.0.0",
    "typescript": "5.7.3",
    "prettier": "3.5.3"
  }
}
